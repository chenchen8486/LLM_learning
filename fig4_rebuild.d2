block: "一层 Block（Pre-Norm）· 共堆 8 层 · 形状全程 [1, 10, 768]" {
  direction: up
  in: "输入 x [1, 10, 768]"
  n1: RMSNorm
  attn: "掩码多头自注意力\nGQA：8 Q 头 / 4 组 K/V · 放大见图 5、图 6"
  add1: ＋ {
    shape: circle
  }
  n2: RMSNorm
  ffn: "FFN：768 → 2432 → 768\nSwiGLU 门控 · 放大见图 7"
  add2: ＋ {
    shape: circle
  }
  out: "输出 [1, 10, 768]\n送下一层"
  in -> n1 -> attn -> add1 -> n2 -> ffn -> add2 -> out
  in -> add1: 残差旁路 {
    style.stroke: "#0891b2"
    style.stroke-dash: 4
  }
  add1 -> add2: 残差旁路 {
    style.stroke: "#0891b2"
    style.stroke-dash: 4
  }
}
